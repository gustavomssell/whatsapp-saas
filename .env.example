# ============================================
# WhatsApp SaaS — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- Backend ---
PORT=8080
ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5435/wpsaas?sslmode=disable
JWT_SECRET=change-this-to-a-strong-random-secret
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=32
UPLOAD_PUBLIC_URL=http://localhost:8090/uploads

# --- Evolution API ---
EVOLUTION_API_URL=http://localhost:8082
EVOLUTION_API_KEY=

# --- PostgreSQL (Docker) ---
POSTGRES_DB=wpsaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
